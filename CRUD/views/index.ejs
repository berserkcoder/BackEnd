<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
        <div>
            <a class="text-blue-500" href="/read">Users Profile</a>
        </div>
        <h1 class="text-3xl tracking-tighter mb-3 mt-10">Create User</h1>
        <form action="/create" method="post">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="text" name="name" placeholder="Enter your name" >
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="text" name="email" placeholder="email">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="text" name="image" placeholder="image url">
            <input class="px-5 py-2 border-2 border-blue-700 bg-blue-600 rounded-lg ml-3" type="submit" value="Create User">
        </form>
    </div>
</body>
</html>