<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 p-10 text-white">
        <h1 class="text-3xl mb-10">Create Account</h1>
        <form action="/register" method="post">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="text" name="name" placeholder="name">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="text" name="username" placeholder="username">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="email" name="email" placeholder="email">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="number" name="age" placeholder="age">
            <input class="px-5 py-2 border-2 border-zinc-800 bg-transparent outline-none rounded-lg" type="password" name="password" placeholder="password">
            <input class="px-5 py-2 border-2 border-blue-700 bg-blue-600 rounded-lg ml-3" type="submit" value="Create User">
        </form>
    </div>
</body>
</html>