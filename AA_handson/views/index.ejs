<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-3xl  mb-4">Create User</h3>
        <form class="mb-4" action="/create" method="post">
            <input class="px-3 py-2 border-2 rounded-md bg-transparent border-zinc-600 outline-none" type="text" placeholder="username" name = "username" >
            <input class="px-3 py-2 border-2 rounded-md bg-transparent border-zinc-600 outline-none" type="email" placeholder="email" name = "email" >
            <input class="px-3 py-2 border-2 rounded-md bg-transparent border-zinc-600 outline-none" type="password" placeholder="password" name = "password" >
            <input class="px-3 py-2 border-2 rounded-md bg-transparent border-zinc-600 outline-none" type="number" placeholder="age" name = "age" >
            <input class="px-5 py-2 rounded-md bg-blue-600 border-2 border-blue-400" type="submit" value="Create User">
        </form>
        <a href="/login"><input class="px-5 py-2 rounded-md bg-blue-600 border-2 border-blue-400" type="submit" value="Login"></a>
        <a href="/logout"><input class="px-5 py-2 rounded-md bg-blue-600 border-2 border-blue-400" type="submit" value="Logout"></a>
    </div>
</body>
</html>